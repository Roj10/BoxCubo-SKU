# Configurações do backend. Copie este arquivo para ".env" (na mesma pasta)
# e preencha. O arquivo .env NÃO vai para o GitHub.

# Endereço do projeto no Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://uoztduvvzcogqghpcgcf.supabase.co

# Chave SECRETA do projeto (Project Settings > API Keys > Secret keys,
# começa com sb_secret_). Não use a chave publicável (sb_publishable_).
# Sem esta chave, o sistema continua usando o arquivo data/boxcubo.json.
SUPABASE_SECRET_KEY=
